@import "tailwindcss";

:root {
  --background: #071018;
  --surface: #0d1822;
  --raised: #12212d;
  --soft: #172a37;
  --border: rgba(152, 181, 199, 0.16);
  --strong-border: rgba(152, 181, 199, 0.28);
  --text: #edf5f8;
  --muted: #8fa5b2;
  --quiet: #607985;
  --cyan: #5bd6dc;
  --green: #69d39e;
  --amber: #f0b96a;
  --red: #ed7f86;
}

* {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  margin: 0;
  background:
    radial-gradient(circle at top left, rgba(35, 101, 117, 0.12), transparent 30rem),
    var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

button {
  font: inherit;
}

.appShell {
  min-height: 100vh;
  padding-bottom: 42px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  min-height: 76px;
  align-items: center;
  padding: 0 26px;
  border-bottom: 1px solid var(--border);
  background: rgba(7, 16, 24, 0.94);
  backdrop-filter: blur(18px);
}

.brandArea,
.brand,
.topActions,
.activeCase,
.buttonRow,
.diagnosisTop,
.confidence,
.statusbar > div {
  display: flex;
  align-items: center;
}

.brandArea {
  gap: 14px;
}

.brand {
  gap: 12px;
}

.brandMark {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border: 1px solid rgba(91, 214, 220, 0.4);
  border-radius: 11px;
  background: rgba(91, 214, 220, 0.1);
  color: var(--cyan);
  font-size: 12px;
  font-weight: 800;
}

.panelHeader p,
.sectionLabel,
.modalHeader p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.brand h1 {
  margin: 0;
  font-size: 18px;
  white-space: nowrap;
}

.aboutButton {
  min-height: 32px;
  padding: 0 12px;
  border: 1px solid var(--strong-border);
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 11px;
  font-weight: 750;
}

.aboutButton:hover {
  border-color: rgba(91, 214, 220, 0.34);
  background: rgba(91, 214, 220, 0.08);
  color: var(--text);
}

.tabs {
  display: flex;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 11px;
}

.tabs button {
  padding: 8px 16px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
}

.tabs button.active {
  background: var(--soft);
  color: var(--text);
}

.topActions {
  justify-content: flex-end;
  gap: 9px;
}

.activeCase {
  gap: 9px;
  margin-right: 10px;
}

.activeCase > span,
.onlineDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
}

.activeCase div {
  display: flex;
  flex-direction: column;
}

.activeCase small,
.metric span {
  color: var(--muted);
  font-size: 10px;
}

.activeCase strong,
.metric strong {
  margin-top: 3px;
  font-size: 12px;
}

.primaryButton,
.secondaryButton {
  min-height: 35px;
  padding: 0 14px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 750;
}

.primaryButton {
  border: 1px solid rgba(91, 214, 220, 0.3);
  background: var(--cyan);
  color: #042026;
}

.secondaryButton {
  border: 1px solid var(--strong-border);
  background: rgba(255, 255, 255, 0.025);
  color: var(--text);
}

.caseStrip {
  display: flex;
  flex-direction: column;
  margin: 18px 24px 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(13, 24, 34, 0.86);
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.16);
}

.stateToolbarRow {
  display: grid;
  grid-template-columns:
    165px
    minmax(155px, 0.82fr)
    minmax(205px, 1.2fr)
    minmax(205px, 1.12fr)
    minmax(145px, 0.78fr)
    minmax(145px, 0.78fr)
    minmax(145px, 0.78fr);
  min-height: 82px;
}

.toolbarHeading,
.toolbarField {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  padding: 13px 17px;
  border-right: 1px solid var(--border);
}

.stateToolbarRow > :last-child {
  border-right: 0;
}

.toolbarHeading {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
}

.toolbarHeading div {
  min-width: 0;
}

.toolbarHeading small {
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.liveIndicator {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 5px rgba(105, 211, 158, 0.09);
}

.toolbarField label {
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.toolbarField input,
.toolbarField select {
  width: 100%;
  min-width: 0;
  height: 34px;
  padding: 0 10px;
  border: 1px solid var(--strong-border);
  border-radius: 8px;
  outline: none;
  background: rgba(255, 255, 255, 0.025);
  color: var(--text);
  font-size: 11px;
  font-weight: 650;
}

.toolbarField input:focus,
.toolbarField select:focus {
  border-color: rgba(91, 214, 220, 0.62);
  box-shadow: 0 0 0 3px rgba(91, 214, 220, 0.08);
}

.toolbarField select {
  cursor: pointer;
}

.unitInput {
  position: relative;
}

.unitInput input {
  padding-right: 35px;
}

.unitInput span {
  position: absolute;
  top: 50%;
  right: 10px;
  color: var(--muted);
  font-size: 10px;
  transform: translateY(-50%);
  pointer-events: none;
}

.intervalsToolbarRow,
.functionalRefractoryPeriodsToolbarRow,
.refractoryPeriodsToolbarRow {
  display: grid;
  grid-template-columns: 165px minmax(0, 1fr);
  min-height: 82px;
  border-top: 1px solid var(--border);
}

.intervalsHeading {
  display: flex;
  align-items: center;
}

.toolbarHeading,
.intervalsHeading {
  position: relative;
  box-sizing: border-box;
  min-width: 165px;
  padding: 16px 17px;
  border-right: 1px solid var(--border);
  background:
    linear-gradient(
      90deg,
      rgba(91, 214, 220, 0.09),
      rgba(91, 214, 220, 0.025)
    );
}

.toolbarHeading::before,
.intervalsHeading::before {
  position: absolute;
  top: 14px;
  bottom: 14px;
  left: 0;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: rgba(91, 214, 220, 0.72);
  content: "";
}

.toolbarHeading small,
.intervalsHeading span {
  color: var(--text);
  font-size: 9px;
  font-weight: 850;
  line-height: 1.45;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.intervalFields {
  display: grid;
  grid-template-columns: repeat(6, minmax(120px, 1fr));
}

.refractoryPeriodFields {
  display: grid;
  grid-template-columns: repeat(8, minmax(120px, 1fr));
}

.functionalRefractoryPeriodsToolbarRow .refractoryPeriodFields {
  grid-template-columns: repeat(4, minmax(150px, 1fr));
}

.intervalField {
  border-right: 1px solid var(--border);
}

.intervalFields > :last-child,
.refractoryPeriodFields > :last-child {
  border-right: 0;
}

.intervalPlaceholder {
  display: flex;
  align-items: center;
  padding: 0 18px;
  color: var(--quiet);
  font-size: 10px;
}

.workspace {
  display: grid;
  grid-template-columns: minmax(300px, 0.9fr) minmax(360px, 1.12fr) minmax(300px, 0.9fr);
  gap: 16px;
  padding: 16px 24px 0;
}

.lowerWorkspace {
  display: grid;
  grid-template-columns: 0.75fr 1.5fr;
  gap: 16px;
  padding: 16px 24px 24px;
}

.panel {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: rgba(13, 24, 34, 0.92);
  box-shadow: 0 22px 55px rgba(0, 0, 0, 0.2);
}

.panelHeader {
  min-height: 67px;
  padding: 15px 17px;
  border-bottom: 1px solid var(--border);
}

.panelHeader h2 {
  margin: 5px 0 0;
  font-size: 15px;
}

.panelBody {
  padding: 15px;
}

.diagnosisList,
.maneuverList,
.evidenceList {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.diagnosisCard {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.018);
}

.diagnosisTop {
  align-items: flex-start;
  gap: 10px;
}

.abbreviation {
  display: grid;
  min-width: 47px;
  height: 30px;
  place-items: center;
  border-radius: 7px;
  background: var(--soft);
  color: var(--cyan);
  font-size: 10px;
  font-weight: 850;
}

.diagnosisText {
  flex: 1;
}

.diagnosisText h3,
.evidenceList h3,
.emptyState h3 {
  margin: 0;
  font-size: 12px;
}

.diagnosisText p,
.evidenceList p,
.emptyState p,
.rationale p,
.synthesis p,
.safetyNotice p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}

.status {
  padding: 4px 7px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 800;
}

.status.leading {
  background: rgba(105, 211, 158, 0.12);
  color: var(--green);
}

.status.possible {
  background: rgba(127, 174, 242, 0.12);
  color: #7faef2;
}

.status.less-likely {
  background: rgba(240, 185, 106, 0.12);
  color: var(--amber);
}

.status.excluded {
  background: rgba(237, 127, 134, 0.12);
  color: var(--red);
}

.confidence {
  gap: 8px;
  margin-top: 11px;
}

.confidence > div {
  overflow: hidden;
  height: 3px;
  flex: 1;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
}

.confidence > div span {
  display: block;
  height: 100%;
  background: var(--cyan);
}

.confidence small {
  color: var(--quiet);
  font-size: 9px;
}

.recommendation {
  display: flex;
  gap: 14px;
  padding: 17px;
  border: 1px solid rgba(91, 214, 220, 0.2);
  border-radius: 12px;
  background: var(--raised);
}

.stepNumber {
  color: rgba(91, 214, 220, 0.34);
  font-size: 27px;
}

.recommendation small,
.synthesis small {
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.recommendation h3 {
  margin: 6px 0;
  font-size: 20px;
}

.recommendation p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
}

.rationale {
  margin: 10px 0;
  padding: 11px 13px;
  border-left: 2px solid var(--cyan);
  background: rgba(91, 214, 220, 0.05);
}

.rationale strong,
.safetyNotice strong {
  font-size: 10px;
}

.buttonRow {
  gap: 8px;
  margin: 12px 0 17px;
}

.buttonRow .primaryButton {
  flex: 1;
}

.maneuverList button {
  display: grid;
  grid-template-columns: 28px 1fr;
  align-items: center;
  padding: 9px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  text-align: left;
}

.maneuverList button.selected {
  border-color: rgba(91, 214, 220, 0.2);
  background: rgba(91, 214, 220, 0.1);
  color: var(--text);
}

.maneuverList strong,
.maneuverList small {
  display: block;
}

.maneuverList strong {
  font-size: 11px;
}

.maneuverList small {
  margin-top: 3px;
  color: var(--muted);
  font-size: 9px;
}

.synthesis {
  padding: 14px;
  border-radius: 11px;
  background: var(--raised);
}

.synthesis h3 {
  margin: 7px 0;
  font-size: 16px;
  line-height: 1.35;
}

.evidenceList {
  margin-top: 10px;
}

.evidenceList article {
  display: grid;
  grid-template-columns: 8px 1fr;
  gap: 10px;
  padding: 10px 4px;
  border-bottom: 1px solid var(--border);
}

.positiveDot,
.unresolvedDot {
  width: 6px;
  height: 6px;
  margin-top: 4px;
  border-radius: 50%;
}

.positiveDot {
  background: var(--green);
}

.unresolvedDot {
  background: var(--amber);
}

.safetyNotice {
  margin-top: 12px;
  padding: 11px 12px;
  border: 1px solid rgba(240, 185, 106, 0.18);
  border-radius: 9px;
  background: rgba(240, 185, 106, 0.1);
}

.emptyState {
  display: grid;
  grid-template-columns: auto 1fr auto;
  min-height: 108px;
  align-items: center;
  gap: 13px;
  padding: 15px;
  border: 1px dashed var(--strong-border);
  border-radius: 11px;
}

.emptyState > span {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border-radius: 9px;
  background: rgba(91, 214, 220, 0.1);
  color: var(--cyan);
  font-size: 20px;
}

.timeline {
  overflow-x: auto;
}

.timelineHeader,
.timelineRow {
  display: grid;
  grid-template-columns: 50px 0.9fr 1.25fr 1fr;
  min-width: 690px;
  align-items: center;
  border-bottom: 1px solid var(--border);
}

.timelineHeader > *,
.timelineRow > * {
  padding: 12px 10px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.45;
}

.timelineHeader > * {
  color: var(--quiet);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.timelineRow strong {
  color: var(--text);
}

.timelineRow > span:first-child {
  color: var(--cyan);
  font-weight: 800;
}

.statusbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 34px;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  border-top: 1px solid var(--border);
  background: rgba(7, 16, 24, 0.95);
  color: var(--quiet);
  font-size: 9px;
}

.statusbar > div {
  gap: 14px;
}

.statusbar strong {
  color: var(--text);
}

.stateLogPanel {
  margin-top: 16px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.018);
}

.stateLogHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  border-bottom: 1px solid var(--border);
}

.stateLogHeader small {
  color: var(--muted);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.stateLogHeader h3 {
  margin: 4px 0 0;
  font-size: 12px;
}

.stateLogHeader > span {
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(91, 214, 220, 0.09);
  color: var(--cyan);
  font-size: 9px;
  font-weight: 800;
}

.stateLogList {
  max-height: 190px;
  overflow-y: auto;
}

.stateLogEntry {
  display: grid;
  grid-template-columns: 42px 1fr;
  align-items: center;
  border-bottom: 1px solid var(--border);
}

.stateLogEntry:last-child {
  border-bottom: 0;
}

.stateLogEntry span,
.stateLogEntry p {
  margin: 0;
  padding: 10px 12px;
  font-size: 9px;
}

.stateLogEntry span {
  color: var(--cyan);
  font-weight: 800;
  text-align: center;
}

.stateLogEntry p {
  border-left: 1px solid var(--border);
  color: var(--muted);
}

.stateLogEmpty {
  padding: 18px 14px;
  color: var(--quiet);
  font-size: 10px;
  line-height: 1.5;
}

.modalBackdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(2, 8, 12, 0.76);
  backdrop-filter: blur(8px);
}

.aboutModal {
  width: min(620px, 100%);
  overflow: hidden;
  border: 1px solid var(--strong-border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
}

.modalHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20px 22px;
  border-bottom: 1px solid var(--border);
}

.modalHeader h2 {
  margin: 6px 0 0;
  font-size: 20px;
}

.modalClose {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border: 1px solid var(--strong-border);
  border-radius: 8px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 20px;
}

.modalClose:hover {
  color: var(--text);
}

.modalBody {
  padding: 22px;
}

.modalBody > p {
  margin: 0 0 14px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.65;
}

.downloadSection {
  margin: 22px 0;
}

.downloadSection h3 {
  margin: 0 0 10px;
  font-size: 12px;
}

.downloadCard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.02);
}

.downloadCard + .downloadCard {
  margin-top: 8px;
}

.downloadCard strong,
.downloadCard span {
  display: block;
}

.downloadCard strong {
  font-size: 11px;
}

.downloadCard span {
  margin-top: 4px;
  color: var(--muted);
  font-size: 10px;
}

.downloadCard button {
  min-width: 96px;
  min-height: 32px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.025);
  color: var(--quiet);
  font-size: 10px;
  font-weight: 750;
}

.modalNotice {
  margin-bottom: 0 !important;
  padding: 11px 12px;
  border: 1px solid rgba(240, 185, 106, 0.18);
  border-radius: 9px;
  background: rgba(240, 185, 106, 0.08);
}

@media (max-width: 1100px) {
  .topbar {
    grid-template-columns: 1fr auto;
  }

  .tabs {
    display: none;
  }

  .workspace {
    grid-template-columns: 1fr 1fr;
  }

  .workspace .panel:last-child {
    grid-column: 1 / -1;
  }

  .lowerWorkspace {
    grid-template-columns: 1fr;
  }

  .caseStrip {
    overflow-x: auto;
  }

  .stateToolbarRow {
    min-width: 1135px;
  }

  .intervalsToolbarRow,
  .functionalRefractoryPeriodsToolbarRow,
  .refractoryPeriodsToolbarRow {
    min-width: 1135px;
  }
}

@media (max-width: 720px) {
  .topbar {
    padding: 14px;
  }

  .activeCase,
  .topActions .secondaryButton {
    display: none;
  }

  .brand h1 {
    font-size: 15px;
    white-space: normal;
  }

  .aboutButton {
    display: none;
  }

  .caseStrip {
    margin: 12px 12px 0;
  }

  .workspace,
  .lowerWorkspace {
    grid-template-columns: 1fr;
    padding-right: 12px;
    padding-left: 12px;
  }

  .workspace .panel:last-child {
    grid-column: auto;
  }

  .statusbar > div:last-child {
    display: none;
  }
}


/* Clinical State architecture v1 */

.clinicalStatesRail {
  position: fixed;
  top: 94px;
  bottom: 24px;
  left: 24px;
  z-index: 5;
  display: flex;
  width: 216px;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: rgba(13, 24, 34, 0.96);
  box-shadow: 0 22px 55px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(16px);
}

.clinicalStatesRailHeader {
  display: flex;
  min-height: 72px;
  align-items: center;
  justify-content: space-between;
  padding: 15px 16px;
  border-bottom: 1px solid var(--border);
}

.clinicalStatesRailHeader p {
  margin: 0 0 5px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.clinicalStatesRailHeader h2 {
  margin: 0;
  font-size: 14px;
}

.clinicalStatesRailHeader > span {
  display: grid;
  min-width: 25px;
  height: 25px;
  place-items: center;
  border: 1px solid rgba(91, 214, 220, 0.25);
  border-radius: 999px;
  background: rgba(91, 214, 220, 0.08);
  color: var(--cyan);
  font-size: 10px;
  font-weight: 850;
}

.clinicalStateCards {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  gap: 8px;
  overflow-y: auto;
  padding: 10px;
}

.clinicalStateCard {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.018);
  color: var(--text);
  cursor: pointer;
  text-align: left;
  transition:
    border-color 120ms ease,
    background 120ms ease,
    transform 120ms ease;
}

.clinicalStateCard:hover {
  border-color: rgba(91, 214, 220, 0.3);
  background: rgba(91, 214, 220, 0.045);
  transform: translateY(-1px);
}

.clinicalStateCard.active {
  border-color: rgba(91, 214, 220, 0.48);
  background:
    linear-gradient(
      135deg,
      rgba(91, 214, 220, 0.13),
      rgba(91, 214, 220, 0.035)
    );
  box-shadow: inset 3px 0 0 rgba(91, 214, 220, 0.9);
}

.clinicalStateCardTop,
.clinicalStateMeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clinicalStateNumber {
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 7px;
  background: var(--soft);
  color: var(--cyan);
  font-size: 9px;
  font-weight: 850;
}

.clinicalStateStatus {
  color: var(--quiet);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.clinicalStateCard.active .clinicalStateStatus {
  color: var(--green);
}

.clinicalStateCard strong {
  display: block;
  margin-top: 11px;
  font-size: 11px;
}

.clinicalStateCard p {
  margin: 4px 0 11px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.4;
}

.clinicalStateMeta {
  gap: 8px;
  color: var(--quiet);
  font-size: 8px;
}

.addClinicalStateButton {
  display: flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin: 10px;
  border: 1px dashed rgba(91, 214, 220, 0.34);
  border-radius: 10px;
  background: rgba(91, 214, 220, 0.045);
  color: var(--cyan);
  cursor: pointer;
  font-size: 10px;
  font-weight: 800;
}

.addClinicalStateButton:hover {
  border-style: solid;
  background: rgba(91, 214, 220, 0.09);
}

.addClinicalStateButton span {
  font-size: 17px;
  font-weight: 400;
}

.caseStrip {
  margin-left: 264px;
}

.workspace,
.lowerWorkspace {
  padding-left: 264px;
}

.clinicalMeasurementRow {
  display: grid;
  grid-template-columns: 165px minmax(0, 1fr);
  min-height: 82px;
  border-top: 1px solid var(--border);
}

.clinicalMeasurementFields {
  display: grid;
  min-width: 0;
  overflow-x: auto;
}

.clinicalMeasurementFields > :last-child {
  border-right: 0;
}

.erpField {
  min-width: 250px;
}

.erpSeriesInput {
  display: flex;
  align-items: center;
  min-width: 0;
}

.erpSeriesComponent {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1 1 0;
}

.erpSeriesComponent input {
  width: 100%;
  min-width: 48px;
  padding-right: 8px;
  padding-left: 8px;
  text-align: center;
}

.erpSeriesSeparator {
  flex: 0 0 auto;
  margin: 0 5px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 750;
}

.erpSeriesUnit {
  flex: 0 0 auto;
  margin-left: 8px;
  color: var(--muted);
  font-size: 10px;
  pointer-events: none;
}

.clinicalWorkspacePlaceholder {
  min-height: 100px;
  padding: 23px;
  border-top: 1px solid var(--border);
}

.clinicalWorkspacePlaceholder strong {
  font-size: 12px;
}

.clinicalWorkspacePlaceholder p {
  max-width: 520px;
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}

@media (max-width: 1180px) {
  .clinicalStatesRail {
    position: static;
    width: auto;
    margin: 18px 24px 0;
  }

  .clinicalStateCards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
    max-height: 260px;
  }

  .caseStrip {
    margin-left: 24px;
  }

  .workspace,
  .lowerWorkspace {
    padding-left: 24px;
  }
}
